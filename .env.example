# Local development only. Replace all values outside a disposable workstation.
POSTGRES_DB=icrm
POSTGRES_USER=icrm
POSTGRES_PASSWORD=local-development-only
MINIO_ROOT_USER=icrm-local
MINIO_ROOT_PASSWORD=local-minio-password
MINIO_BUCKET=materials
ICRM_PORT=8080
ICRM_MODELS_DIR=/app/models
# 可选：云端字段抽取（OpenAI 兼容 DeepSeek）。留空则关闭云端路径，仅保留本地候选抽取。
ICRM_DEEPSEEK_BASE_URL=
ICRM_DEEPSEEK_API_KEY=
ICRM_DEEPSEEK_MODEL=
# 云端启用门禁（设计 10.2）：必须同时设置“供应商承诺不用于训练”与明确留存期限，
# 云端路径才会启用；缺失时 DeepSeek 关闭，本地候选抽取不受影响。
ICRM_CLOUD_TRAINING_CONFIRMATION=false
ICRM_CLOUD_RETENTION_DAYS=
