    "@vue/test-utils": "2.4.6",
    "jsdom": "26.0.0",
    "openapi-typescript": "7.6.1",
    "typescript": "5.8.2",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "vue-tsc": "2.2.8"
