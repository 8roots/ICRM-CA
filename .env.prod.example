# Production secret files (docker-compose.prod.yml). Create ./secrets/* with
# real values; these files are mounted into the containers as Docker secrets
# and never appear in the environment, logs, or image.
#
#   cp -a .env.prod.example ./secrets  # then edit each file
#
# ./secrets/postgres_password   - PostgreSQL password (no trailing newline)
# ./secrets/minio_root_user     - MinIO root user
# ./secrets/minio_root_password - MinIO root password
# ./secrets/database_url        - full SQLAlchemy URL, e.g.
#                                 postgresql+psycopg://icrm:PASSWORD@postgres:5432/icrm
# ./secrets/deepseek_api_key    - DeepSeek key, or empty to keep cloud off
#
# TLS certificates (host paths mounted read-only):
#   ./certs/fullchain.pem
#   ./certs/privkey.pem

# Cloud readiness gate (design 10.2): set to true and provide a retention
# period only after the provider contract confirms no-training + retention.
ICRM_DEEPSEEK_BASE_URL=
ICRM_DEEPSEEK_MODEL=
ICRM_CLOUD_TRAINING_CONFIRMATION=false
ICRM_CLOUD_RETENTION_DAYS=

# Optional capacity tuning (defaults shown)
ICRM_MAX_MATERIAL_BYTES=209715200
ICRM_MAX_APPLICATION_BYTES=2147483648
ICRM_MAX_APPLICATION_MATERIALS=100

# Ports exposed on the proxy
ICRM_HTTPS_PORT=443
ICRM_HTTP_PORT=80
